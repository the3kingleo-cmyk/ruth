#!/usr/bin/env bash
# opencode-sync: mirror the canonical workspace (GitHub, FIRST place) -> local (SECOND place).
# Runs at every session start (via opencode-auto) and at the top of every agent-cycle.
# Pulls: soul/* + AGENTS.md + memory/stable-memory.md  -> ~/.config/opencode/workspace/
#        state/*                                        -> ~/.config/opencode/
# Exit 0 only when every file was fetched (HTTP 200). Anything less = stale soul = do not act.
set -uo pipefail

# Deployment values live on this machine, never in the public repo.
RUTH_ENV_FILE="${RUTH_ENV_FILE:-$HOME/.config/opencode/ruth.env}"
[ -f "$RUTH_ENV_FILE" ] && . "$RUTH_ENV_FILE"

REPO="${RUTH_MEMORY_REPO:-${RUTH_OWNER:-owner}/memory}"
CFG="$HOME/.config/opencode"
WS="$CFG/workspace"
TOKEN_FILE="$HOME/.github_token"
API="https://api.github.com/repos/$REPO/contents"

KEY=""
[ -s "$TOKEN_FILE" ] && KEY=$(tr -d '[:space:]' < "$TOKEN_FILE")
[ -z "$KEY" ] && { echo "ERR: no github token at $TOKEN_FILE"; exit 1; }

mkdir -p "$WS/soul" "$WS/memory" "$WS/directives/inbox" "$WS/skills/gumroad" "$CFG"

# path-in-repo -> local target
declare -A MAP=(
  ["AGENTS.md"]="$WS/AGENTS.md"
  ["soul/SOUL.md"]="$WS/soul/SOUL.md"
  ["soul/IDENTITY.md"]="$WS/soul/IDENTITY.md"
  ["soul/USER.md"]="$WS/soul/USER.md"
  ["soul/VOICE.md"]="$WS/soul/VOICE.md"
  ["directives/operating-rules.md"]="$WS/directives/operating-rules.md"
  ["memory/stable-memory.md"]="$WS/memory/stable-memory.md"
  ["skills/gumroad/SKILL.md"]="$WS/skills/gumroad/SKILL.md"
  ["state/AGENT_STATE.md"]="$CFG/AGENT_STATE.md"
  ["state/WORKLOG.md"]="$CFG/WORKLOG.md"
  ["state/ERROR_LOG.md"]="$CFG/ERROR_LOG.md"
)

fetch() { # fetch <repo-path> <local-target>  (ETag-cached; 304 = unchanged)
  local rp="$1" lt="$2"
  local et="$lt.etag" tmp code hdr
  tmp=$(mktemp); hdr=$(mktemp)
  local -a inm=()
  if [ -s "$lt" ] && [ -s "$et" ]; then inm=(-H "If-None-Match: $(cat "$et")"); fi
  code=$(curl -s --max-time 25 -w '%{http_code}' -D "$hdr" "${inm[@]}" \
      -H "Authorization: Bearer $KEY" -H "User-Agent: opencode-agent" \
      -H "Accept: application/vnd.github.raw+json" "$API/$rp" -o "$tmp")
  case "$code" in
    200) mv "$tmp" "$lt"; grep -i '^etag:' "$hdr" | awk '{print $2}' | tr -d '\r' > "$et"; echo "  ↓ $rp";;
    304) rm -f "$tmp"; echo "  = $rp";;
    *)   rm -f "$tmp"; echo "  ✗ $rp HTTP $code (kept local)"; return 1;;
  esac
  rm -f "$hdr"
}

ok=0; total=${#MAP[@]}
for rp in "${!MAP[@]}"; do
  lt="${MAP[$rp]}"
  # state/* ledgers are WRITTEN on this box (doctor, agent-cycle) and pushed up.
  # Pull them only to bootstrap a fresh/wiped box; never clobber local appends.
  if [[ "$rp" == state/* ]] && [ -s "$lt" ]; then echo "  ≡ $rp (local ledger authoritative)"; ok=$((ok+1)); continue; fi
  fetch "$rp" "$lt" && ok=$((ok+1))
done

# inbox listing (cheap: one call) so the agent knows if work is queued
inbox=$(curl -s --max-time 15 -H "Authorization: Bearer $KEY" "$API/directives/inbox" \
        | jq -r '[.[]? | select(.name!="README.md") | .name] | join(" ")' 2>/dev/null)
echo "${inbox:-}" > "$WS/directives/inbox/.queued"

echo "workspace synced GitHub -> local ($ok/$total files)${inbox:+; inbox: $inbox}"
[ "$ok" -eq "$total" ]
